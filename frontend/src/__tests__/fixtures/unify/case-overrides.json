            "kind": "prop",
            "name": "name"
          },
          "normalize": "lower"
        },
        {
          "node_type": "Account",
          "entity": "Account",
          "source": "node_id",
          "normalize": "account"
        }
      ]
    },
    "c-crm": {
      "identity_keys": []
    }
  },
  "sources": [
