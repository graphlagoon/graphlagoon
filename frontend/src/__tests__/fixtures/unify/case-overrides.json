            "name": "Ana R."
          }
        },
        {
          "id": "0341-0001234-5",
          "type": "Account",
          "properties": {}
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "p1",
          "target": "0341-0001234-5",
          "type": "HOLDS",
          "properties": {}
        }
      ]
    },
    {
