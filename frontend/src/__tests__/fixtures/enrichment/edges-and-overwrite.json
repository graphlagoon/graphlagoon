        }
      },
      "a1@c-bank": {
        "properties": {}
      },
      "a2@c-bank": {
        "properties": {
          "segment": null
        }
      },
      "0042@c-crm": {
        "properties": {
          "city": "Recife"
        }
      }
    },
    "edges": {
      "s-bank:e1": {
        "properties": {
          "channel": "branch"
        }
      },
      "s-bank:e2": {
        "properties": {
          "amount": 99,
          "channel": "app"
        }
      }
    }
  }
