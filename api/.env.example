# Graph Lagoon Studio Configuration
# All variables use GRAPH_LAGOON_ prefix to avoid conflicts with other applications

# Local sql-warehouse (dev mode)
GRAPH_LAGOON_SQL_WAREHOUSE_URL=http://localhost:8001

# Database (optional - disabled by default, uses localStorage on frontend)
# Set GRAPH_LAGOON_DATABASE_ENABLED=true to enable PostgreSQL persistence
GRAPH_LAGOON_DATABASE_URL=postgresql+asyncpg://sgraph:sgraph@localhost:5432/sgraph
GRAPH_LAGOON_DATABASE_ENABLED=false

# General settings
GRAPH_LAGOON_DEV_MODE=true
GRAPH_LAGOON_PORT=8000

# Frontend defaults (optional)
# JSON object seeding the initial values of the Behaviors panel. Keys are passed
# through to the frontend and merged over its own defaults, so any behavior the
# frontend supports works here without a backend change. Users can still change
# them in the panel, and a saved exploration overrides them.
# Invalid JSON is ignored (logged as a warning), not fatal.
# GRAPH_LAGOON_DEFAULT_BEHAVIORS={"mapStylePan": false, "viewMode": "3d"}

# Databricks connection (production mode)
# Set GRAPH_LAGOON_DATABRICKS_MODE=true to connect directly to Databricks
# When GRAPH_LAGOON_DATABRICKS_MODE=true, CATALOG and SCHEMA are required
GRAPH_LAGOON_DATABRICKS_MODE=false
GRAPH_LAGOON_DATABRICKS_HOST=
GRAPH_LAGOON_DATABRICKS_TOKEN=
GRAPH_LAGOON_DATABRICKS_WAREHOUSE_ID=
GRAPH_LAGOON_DATABRICKS_CATALOG=
GRAPH_LAGOON_DATABRICKS_SCHEMA=

# Amazon Neptune (openCypher) — a native graph database datasource.
# Setting the endpoint is what enables it; contexts then pick "neptune" as
# their datasource and need no edge/node tables at all.
# GRAPH_LAGOON_NEPTUNE_ENDPOINT=my-cluster.cluster-abc.us-east-1.neptune.amazonaws.com
# GRAPH_LAGOON_NEPTUNE_PORT=8182
# IAM-auth clusters only; needs the 'neptune-iam' extra (botocore).
# GRAPH_LAGOON_NEPTUNE_USE_IAM=false
# GRAPH_LAGOON_NEPTUNE_REGION=us-east-1
# Set false only for the local emulator (`make dev-neptune`), which is plain http.
# GRAPH_LAGOON_NEPTUNE_USE_TLS=true

# Exploration snapshots (file-based graph state persistence)
# Local mode: directory where .json.gz snapshot files are stored (created automatically)
GRAPH_LAGOON_EXPLORATION_SNAPSHOTS_DIR=./tmp/explorations
# Databricks mode: Unity Catalog Volume path for snapshots (required when DATABRICKS_MODE=true)
# GRAPH_LAGOON_DATABRICKS_VOLUME_PATH=/Volumes/catalog/schema/volume_name

# Precomputed graphs (opened via /graph/{id}?precomputed={name}&<provider args>)
# Reading needs only context access. Writing needs GRAPH_LAGOON_SUPERUSER_EMAILS
# (see "Access Control" below) AND a provider that declares the capability —
# most do not, so PUT/DELETE answer 405 there.
# These settings configure the built-in volume provider, which is the default.
# Other providers (Lakebase, Delta, ...) are registered in code — see
# docs/guide/precomputed-graphs.md.
GRAPH_LAGOON_PRECOMPUTED_GRAPHS_ENABLED=true
GRAPH_LAGOON_PRECOMPUTED_GRAPHS_DIR=./tmp/precomputed-graphs
# Set a volume path for any deployment with more than one replica — otherwise each
# replica keeps its own copy and a link works only intermittently.
# Defaults to {DATABRICKS_VOLUME_PATH}/precomputed-graphs when that is set.
# GRAPH_LAGOON_PRECOMPUTED_GRAPHS_VOLUME_PATH=/Volumes/catalog/schema/volume_name/precomputed-graphs
# Maximum compressed size of one entry (default 200 MB)
# GRAPH_LAGOON_PRECOMPUTED_GRAPHS_MAX_BYTES=209715200

# Style presets (named style + labels + layout, applied via /graph/{id}?style={name})
# Readable by anyone with context access, writable with context write access;
# only the creator of a preset may delete it.
GRAPH_LAGOON_STYLE_PRESETS_ENABLED=true
GRAPH_LAGOON_STYLE_PRESETS_DIR=./tmp/style-presets
# Defaults to {DATABRICKS_VOLUME_PATH}/style-presets when that is set.
# GRAPH_LAGOON_STYLE_PRESETS_VOLUME_PATH=/Volumes/catalog/schema/volume_name/style-presets
# Presets are listed in full for the picker, so the count is capped here.
# GRAPH_LAGOON_STYLE_PRESETS_MAX_PER_CONTEXT=100

# Custom metrics: writer-authored per-node/edge JavaScript, evaluated in a
# sandboxed worker of every writer's browser. Off hides every definition and
# rejects writes; the second flag alone forbids automatic runs on graph load
# (every metric then evaluates only on Recompute).
GRAPH_LAGOON_CUSTOM_METRICS_ENABLED=true
GRAPH_LAGOON_CUSTOM_METRICS_AUTO_RUN_ENABLED=true
GRAPH_LAGOON_SUPERUSER_EMAILS=devmessias@gmail.com
